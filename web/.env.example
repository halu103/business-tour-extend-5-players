# Optional: correct source repository. Copied Far Far West URLs are rejected.
PUBLIC_REPOSITORY_URL=https://github.com/halu103/business-tour-extend-5-players
# Set the real public HTTPS homepage when deploying; no domain is guessed.
PUBLIC_SITE_URL=
# Optional absolute HTTPS social preview image URL (PNG/JPG recommended).
PUBLIC_OG_IMAGE_URL=
# Optional creator support link; blank hides it.
PUBLIC_BUYME_URL=
# Optional server-only GitHub token. Never use a PUBLIC_ prefix.
PRIVATE_GITHUB_TOKEN=
