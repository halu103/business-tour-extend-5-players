+/**
+ * Windows requires elevated permissions for directory symlinks unless Developer Mode is enabled.
+ * Junctions provide the same directory-link behaviour for local Vercel builds without elevation.
+ * @param {string} target
+ * @param {string} destination
+ */
+function symlink_directory(target, destination) {
+	if (process.platform === 'win32') {
+		fs.symlinkSync(path.resolve(path.dirname(destination), target), destination, 'junction');
+	} else {
+		fs.symlinkSync(target, destination, 'dir');
+	}
+}
